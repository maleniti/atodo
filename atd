#!/usr/bin/env bash
# Builds the advanced-todo image and (re)runs it, detached, on the given
# port. Safe to re-run any time -- an existing container with the same name
# is replaced regardless of whether the image actually changed, since a
# no-op rebuild is cheap and there's no meaningful state to lose (all data
# lives in the browser's localStorage, not the container).
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <port>" >&2
  exit 1
fi

port="$1"
image="advanced-todo"
container="advanced-todo"

cd "$(dirname "$0")"

# .env holds secrets (currently just UNSPLASH_ACCESS_KEY -- see
# config.example.js/CLAUDE.md's Configuration section) that get forwarded
# into the container below. Gitignored, never baked into the image itself --
# required rather than defaulting to empty so a missing key fails loudly here
# instead of silently shipping a container with backgrounds disabled.
if [ ! -f .env ]; then
  echo ".env not found -- copy config.example.js's key into a .env file (UNSPLASH_ACCESS_KEY=...) first." >&2
  exit 1
fi
set -a
# shellcheck source=/dev/null
. ./.env
set +a

docker build -t "$image" .

if docker ps -a --format '{{.Names}}' | grep -qx "$container"; then
  docker rm -f "$container" >/dev/null
fi

docker run -d --name "$container" -p "$port:80" -e "UNSPLASH_ACCESS_KEY=${UNSPLASH_ACCESS_KEY:-}" "$image"

echo "advanced-todo running at http://localhost:$port"
